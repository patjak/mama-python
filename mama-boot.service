[Unit]
Description=MAMA iPXE Boot Server
After=network-online.target nfs-server.service dnsmasq.service
Wants=network-online.target nfs-server.service dnsmasq.service

[Service]
Type=simple
User=root
Group=root
Environment="PYTHONUNBUFFERED=1"
WorkingDirectory=/usr/share/mama
ExecStart=/usr/bin/mama serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
