#!/usr/bin/env python3
from __future__ import annotations

import pathlib
import sys

# Ensure src/ is on sys.path for direct repository execution
_src_dir = pathlib.Path(__file__).parent / "src"
if _src_dir.is_dir():
    sys.path.insert(0, str(_src_dir.resolve()))

from mama.main import main

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
