#!/usr/bin/env python3
import pathlib
import socket
import sys

mama_path = pathlib.Path("/usr/share/mama")

import config
config.MAMA_PATH = str(mama_path)

# Gracefully fall back if system hostname cannot be resolved
try:
    config.MAMA_HOST = socket.gethostbyname(socket.gethostname())
except (socket.gaierror, OSError):
    config.MAMA_HOST = "127.0.0.1"

config.SETTINGS_FILE = str(mama_path / "mama.xml")

# Load configuration override if present
etc_config = pathlib.Path("/etc/mama.py")
if etc_config.exists():
    import importlib.util
    spec = importlib.util.spec_from_file_location("etc_mama", str(etc_config))
    if spec and spec.loader:
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)

from main import main

if __name__ == "__main__":
    main()